# ============================================================
#  Portfolio Backend — variables d'environnement
#  Copier en .env et adapter.
# ============================================================

# ---- Identifiants admin ----
ADMIN_EMAIL=charbelazon23@gmail.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Secret JWT (regenerer en prod !) ----
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-secret-in-production

# ---- Connexion DB ----
# Pour pointer vers la db/ locale (docker compose):
#   DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@db:5432/portfolio
# Pour une DB managee (Supabase/Neon/RDS) :
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/DB
DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@host.docker.internal:5432/portfolio

# ---- URL publique du backend (utilise pour construire les cv_url / photo_url
# absolus quand frontend et backend sont sur des domaines differents) ----
APP_BASE_URL=

# ---- Origines CORS autorisees (JSON array) ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4173"]

# ---- Port host (par defaut 8000) ----
BACKEND_HOST_PORT=8000
