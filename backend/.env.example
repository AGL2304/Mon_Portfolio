# ============================================================
#  Backend — variables d'environnement
#  Copier en .env et adapter les valeurs.
# ============================================================

# ----- Identifiants admin -----
ADMIN_EMAIL="charbelazon23@gmail.com"
ADMIN_PASSWORD="change-me-please"

# Secret JWT — générer une valeur forte en production :
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET="change-this-secret-in-production"

# ----- Base de données -----
# Doit correspondre aux variables définies dans db/.env
DATABASE_URL="postgresql+psycopg2://portfolio:portfolio@db:5432/portfolio"

# ----- URL publique (optionnel) -----
# Si vide, les URLs CV/photo seront relatives.
APP_BASE_URL=""

# ----- CORS (JSON array) -----
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://localhost:4173"]'
