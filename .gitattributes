# Treat the following as binary — never apply LF/CRLF conversion
*.pdf  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.gz   binary
*.tar  binary

# Force LF for text files to avoid Windows CRLF noise in diffs
*.md       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.sh       text eol=lf
