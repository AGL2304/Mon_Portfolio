# ============================================================
#  Portfolio orchestrateur — variables d'env partagees
#  Copier en .env et adapter. Utilise par docker-compose.yml racine.
#
#  Pour deployer un service seul, voir .env.example dans chaque
#  sous-dossier (db/, backend/, frontend/).
# ============================================================

# ---- DB (utilise par db ET backend pour construire DATABASE_URL) ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=portfolio

# ---- Backend ----
ADMIN_EMAIL=charbelazon23@gmail.com
ADMIN_PASSWORD=change-me-strong-password
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-secret-in-production
APP_BASE_URL=
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend ----
VITE_API_URL=/api
