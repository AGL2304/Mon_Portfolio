# ============================================================
#  Portfolio - variables d'environnement
#  Copier en .env et adapter les valeurs.
# ============================================================

# ----- Identifiants admin (panel d'administration) -----
ADMIN_EMAIL="charbelazon23@gmail.com"
ADMIN_PASSWORD="change-me-please"

# Secret JWT - generer une valeur aleatoire forte en production.
# Astuce: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET="change-this-secret-in-production"

# ----- Base de donnees PostgreSQL -----
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD="portfolio"
POSTGRES_DB="portfolio"
DATABASE_URL="postgresql+psycopg2://portfolio:portfolio@db:5432/portfolio"

# ----- URLs publiques -----
# Si vide, les URLs CV/photo seront relatives (recommande quand front et back
# sont sur le meme domaine ou via reverse proxy).
APP_BASE_URL=""

# Origines CORS autorisees (JSON array)
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://localhost:4173"]'

# ----- Frontend (build-time) -----
# Pointe vers l'API depuis le navigateur. En dev local sans Docker:
# VITE_API_URL="http://localhost:8000/api"
# En docker-compose (nginx proxy), garde "/api".
VITE_API_URL="/api"
