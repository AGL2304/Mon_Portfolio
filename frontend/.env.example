# ============================================================
#  Portfolio Frontend — variables d'environnement
#  Copier en .env et adapter.
# ============================================================

# ---- URL de l'API (utilise par le build Vite) ----
# Si le frontend est servi sur le meme domaine que le backend (nginx
# proxy ou reverse proxy), laisser /api. Sinon URL absolue :
#   VITE_API_URL=https://api.portfolio.example.com/api
VITE_API_URL=/api

# ---- Hote du backend resolu par nginx au runtime (envsubst) ----
# En dev compose : `backend` (service name docker-compose root)
# En standalone hors compose : host.docker.internal (backend sur l'hote)
# En prod self-hosted : nom DNS du backend
BACKEND_HOST=host.docker.internal
BACKEND_PORT=8000

# ---- Port host (par defaut 3000) ----
FRONTEND_HOST_PORT=3000
