# ============================================================
#  Frontend — variables d'environnement (build-time)
#  Copier en .env et adapter si nécessaire.
# ============================================================

# URL de l'API depuis le navigateur.
# En dev local (sans Docker) :
#   VITE_API_URL="http://localhost:8000/api"
# En docker-compose (nginx proxy /api → backend) :
#   VITE_API_URL="/api"
VITE_API_URL="/api"
